<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".FakeCallActivity">

    <!-- Glowing Background Effect -->
    <View
        android:id="@+id/glow_effect"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/circle_red"
        android:alpha="0.2"
        app:layout_constraintBottom_toBottomOf="@+id/siren_play"
        app:layout_constraintEnd_toEndOf="@+id/siren_play"
        app:layout_constraintStart_toStartOf="@+id/siren_play"
        app:layout_constraintTop_toTopOf="@+id/siren_play" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="SECURITY DETERRENT"
        android:textColor="#FF5252"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="8dp"
        android:text="Activate the siren or simulate a call to deter threats."
        android:textAlignment="center"
        android:textColor="#99FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/siren_play"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="#FF5252"
        android:padding="40dp"
        android:src="@drawable/emergency"
        app:contentDescription="Play Siren"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tv_siren_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="TAP FOR LOUD SIREN"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siren_play" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_simulate_call"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="48dp"
        android:text="SIMULATE INCOMING CALL"
        android:textColor="@color/white"
        app:strokeColor="#FF5252"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
