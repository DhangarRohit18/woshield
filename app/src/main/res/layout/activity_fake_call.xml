<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_ivory"
    tools:context=".FakeCallActivity">

    <!-- Glowing Background Effect -->
    <View
        android:id="@+id/glow_effect"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/circle_red"
        android:alpha="0.2"
        app:layout_constraintBottom_toBottomOf="@+id/siren_play"
        app:layout_constraintEnd_toEndOf="@+id/siren_play"
        app:layout_constraintStart_toStartOf="@+id/siren_play"
        app:layout_constraintTop_toTopOf="@+id/siren_play" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Security Deterrent"
        android:textColor="@color/midnight_slate"
        android:textSize="26sp"
        android:fontFamily="sans-serif-black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="6dp"
        android:text="Activate a loud alarm siren or simulate an incoming call to deter threats."
        android:textAlignment="center"
        android:textColor="@color/secondary_slate"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/siren_play"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@color/critical_red"
        android:padding="36dp"
        android:src="@drawable/emergency"
        app:contentDescription="Play Siren"
        app:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tv_siren_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="TAP FOR LOUD SIREN"
        android:textColor="@color/critical_red"
        android:textSize="15sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.06"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siren_play" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_simulate_call"
        style="@style/Widget.Woshield.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="40dp"
        android:text="SIMULATE INCOMING CALL"
        android:textColor="@color/royal_violet"
        android:textSize="14sp"
        app:strokeColor="@color/royal_violet"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
