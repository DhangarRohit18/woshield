<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EmpowHer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.EmpowHer" parent="Base.Theme.EmpowHer" />

    <!-- Style for Circular Images -->
    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

        <!-- Dashboard Card -->
        <style name="DashboardCard">
            <item name="cardCornerRadius">16dp</item>
            <item name="cardElevation">8dp</item>
            <item name="android:layout_width">160dp</item>
            <item name="android:layout_height">150dp</item>
            <item name="android:layout_margin">12dp</item>
            <item name="android:background">@color/white</item>
        </style>

        <!-- Card Content Layout -->
        <style name="DashboardCardContainer">
            <item name="android:gravity">center</item>
            <item name="android:orientation">vertical</item>
            <item name="android:padding">10dp</item>
        </style>

        <!-- Card Icon -->
        <style name="DashboardIcon">
            <item name="android:layout_width">70dp</item>
            <item name="android:layout_height">70dp</item>
            <item name="android:tint">@color/black</item>

        </style>

        <!-- Card Title -->
        <style name="DashboardText">
            <item name="android:textSize">16sp</item>
            <item name="android:textStyle">bold</item>
            <item name="android:textColor">@color/black</item>
        </style>


</resources>
